<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <appSettings>
    <add key="BridgeMode" value="ReadOnly" />
    <add key="ListenPrefix" value="http://127.0.0.1:18080/" />
    <add key="TradeServiceEndpoint" value="net.tcp://localhost:9092/TradeService" />
    <add key="MaxResponseItems" value="200" />
  </appSettings>
</configuration>
